{
  "manifest_version": 3,
  "name": "Send to Kids Over Profits",
  "version": "0.2.0",
  "description": "Send websites, articles, lawsuits, and legislation to the Kids Over Profits review queues.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to KOP",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "notifications"],
  "optional_host_permissions": ["https://*/*"],
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open Send to KOP"
    }
  }
}
